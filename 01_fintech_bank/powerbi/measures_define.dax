// Вставьте целиком в «Представление запросов DAX» и нажмите над DEFINE
// «Обновить модель: добавить новые меры». Меры «Объём, ₸», «Объём, млрд ₸», «Выдач» уже созданы.
DEFINE
    MEASURE '_Меры'[Объём, млн ₸] =
        DIVIDE ( [Объём, ₸], 1000000 )
    MEASURE '_Меры'[Средний чек, млн ₸] =
        DIVIDE ( [Объём, ₸], [Выдач] ) / 1000000
    MEASURE '_Меры'[Медианный чек, млн ₸] =
        MEDIAN ( fact_loans[amount_kzt] ) / 1000000
    MEASURE '_Меры'[Медианный залоговый чек, млн ₸] =
        CALCULATE ( [Медианный чек, млн ₸], fact_loans[product] = "Залоговый займ" )
    MEASURE '_Меры'[Доля залоговых в объёме] =
        DIVIDE ( CALCULATE ( [Объём, ₸], fact_loans[product] = "Залоговый займ" ), [Объём, ₸] )
    MEASURE '_Меры'[Активных менеджеров] =
        DISTINCTCOUNT ( fact_loans[manager_id] )
    MEASURE '_Меры'[Менеджеро-месяцы] =
        SUMX ( VALUES ( dim_date[year_month] ), CALCULATE ( DISTINCTCOUNT ( fact_loans[manager_id] ) ) )
    MEASURE '_Меры'[Выдач на менеджера в месяц] =
        DIVIDE ( [Выдач], [Менеджеро-месяцы] )
    MEASURE '_Меры'[Штатные менеджеро-месяцы] =
        SUMX (
        FILTER ( VALUES ( dim_date[month_start] ), dim_date[month_start] <= MAX ( fact_loans[date] ) ),
        IF ( dim_date[month_start] >= DATE ( 2026, 5, 1 ), 7, 6 )
    )
    MEASURE '_Меры'[Укомплектованность штата] =
        DIVIDE ( [Менеджеро-месяцы], [Штатные менеджеро-месяцы] )
    MEASURE '_Меры'[Объём на менеджера в месяц, млн ₸] =
        DIVIDE ( [Объём, млн ₸], [Менеджеро-месяцы] )
    MEASURE '_Меры'[Доля в объёме команды] =
        DIVIDE ( [Объём, ₸], CALCULATE ( [Объём, ₸], ALL ( dim_manager ) ) )
    MEASURE '_Меры'[Объём LY, ₸] =
        CALCULATE ( [Объём, ₸], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE '_Меры'[Δ объёма к прошлому году, %] =
        DIVIDE ( [Объём, ₸] - [Объём LY, ₸], [Объём LY, ₸] )
    MEASURE '_Меры'[Выдач LY] =
        CALCULATE ( [Выдач], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE '_Меры'[Δ выдач к прошлому году, шт] =
        [Выдач] - [Выдач LY]
    MEASURE '_Меры'[Δ выдач к прошлому году, %] =
        DIVIDE ( [Выдач] - [Выдач LY], [Выдач LY] )
    MEASURE '_Меры'[Выдач на менеджера LY] =
        CALCULATE ( [Выдач на менеджера в месяц], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE '_Меры'[Δ продуктивности, %] =
        DIVIDE ( [Выдач на менеджера в месяц] - [Выдач на менеджера LY], [Выдач на менеджера LY] )
    MEASURE '_Меры'[Повторных выдач] =
        CALCULATE ( [Выдач], fact_loans[is_repeat] = 1 )
    MEASURE '_Меры'[Доля повторных выдач] =
        DIVIDE ( [Повторных выдач], [Выдач] )
    MEASURE '_Меры'[Клиентов] =
        DISTINCTCOUNT ( fact_loans[client_id] )
    MEASURE '_Меры'[Факт для прогноза, млн ₸] =
        IF ( MAX ( dim_date[date] ) <= DATE ( 2026, 9, 30 ), [Объём, млн ₸] )
    MEASURE '_Меры'[Прогноз: база, млн ₸] =
        SUM ( fact_forecast[base_mln] )
    MEASURE '_Меры'[Прогноз: нижняя граница, млн ₸] =
        SUM ( fact_forecast[low_mln] )
    MEASURE '_Меры'[Прогноз: верхняя граница, млн ₸] =
        SUM ( fact_forecast[high_mln] )
    MEASURE '_Меры'[Прогноз: + беззалог, млн ₸] =
        SUM ( fact_forecast[s1_unsecured_mln] )
    MEASURE '_Меры'[Прогноз: + залоговые, млн ₸] =
        SUM ( fact_forecast[s2_secured_mln] )
    MEASURE '_Меры'[Прогноз: все шаги, млн ₸] =
        SUM ( fact_forecast[s3_repeat_clients_mln] )
    MEASURE '_Меры'[Прогноз 4 кв.: база, млрд ₸] =
        CALCULATE ( [Прогноз: база, млн ₸], ALL ( dim_date ) ) / 1000
    MEASURE '_Меры'[Прогноз 4 кв.: все шаги, млрд ₸] =
        CALCULATE ( [Прогноз: все шаги, млн ₸], ALL ( dim_date ) ) / 1000
    MEASURE '_Меры'[Факт 4 кв. 2025, млрд ₸] =
        CALCULATE ( [Объём, млрд ₸], DATESBETWEEN ( dim_date[date], DATE ( 2025, 10, 1 ), DATE ( 2025, 12, 31 ) ) )
    MEASURE '_Меры'[Прогноз 4 кв. к 2025, %] =
        DIVIDE ( [Прогноз 4 кв.: база, млрд ₸], [Факт 4 кв. 2025, млрд ₸] ) - 1

EVALUATE
    ROW ( "Выдач на менеджера в месяц", [Выдач на менеджера в месяц], "Укомплектованность", [Укомплектованность штата] )
