// =====================================================================
//  DAX-меры для дашборда «Квартира под сдачу в Астане»
//  Как добавить: Моделирование → Новая мера → вставить ОДНУ меру целиком.
//  Меры для удобства кладём в таблицу sale_investment (или в отдельную
//  пустую таблицу «_Меры»: Главная → Ввести данные → OK).
// =====================================================================


// ---------- Страница 1. Обзор рынка (таблица flats) ----------

Объявлений = COUNTROWS ( flats )

Объявлений продажи =
CALCULATE ( COUNTROWS ( flats ), flats[deal] = "Продажа" )

Объявлений аренды =
CALCULATE ( COUNTROWS ( flats ), flats[deal] = "Аренда" )

Медиана цены продажи, млн =
CALCULATE ( MEDIAN ( flats[price_kzt] ), flats[deal] = "Продажа" ) / 1000000

Медиана аренды в месяц =
CALCULATE ( MEDIAN ( flats[price_kzt] ), flats[deal] = "Аренда" )

Медиана цены за м2 (продажа) =
CALCULATE ( MEDIAN ( flats[price_per_m2] ), flats[deal] = "Продажа" )

Медиана аренды за м2 =
CALCULATE ( MEDIAN ( flats[price_per_m2] ), flats[deal] = "Аренда" )

// Доля комнатности внутри типа сделки (для графика «структура предложения»):
// какая доля объявлений продажи — однушки, какая доля аренды — однушки и т.д.
Доля объявлений =
DIVIDE ( [Объявлений], CALCULATE ( [Объявлений], REMOVEFILTERS ( flats[rooms] ) ) )

// Отношение «аренда / продажа» по числу объявлений — насколько район насыщен арендой
Аренда на 1 продажу =
DIVIDE ( [Объявлений аренды], [Объявлений продажи] )


// ---------- Страница 2. Доходность (таблица sale_investment) ----------

Квартир на продажу = COUNTROWS ( sale_investment )

Валовая доходность = MEDIAN ( sale_investment[gross_yield] )

Чистая доходность = MEDIAN ( sale_investment[net_yield] )

Реальная доходность = MEDIAN ( sale_investment[real_net_yield] )

Окупаемость, лет = MEDIAN ( sale_investment[payback_years] )

Ставка депозита = 0.147

// Насколько чистая доходность выше / ниже депозита (в п.п.)
Доходность минус депозит = [Чистая доходность] - [Ставка депозита]

// Доля квартир, где аренда обгоняет инфляцию
Доля выше инфляции =
DIVIDE (
    CALCULATE ( COUNTROWS ( sale_investment ), sale_investment[real_net_yield] > 0 ),
    [Квартир на продажу]
)

// Средний уровень по городу — для сравнения в карточках и линиях на графиках
Чистая доходность по городу =
CALCULATE ( [Чистая доходность], REMOVEFILTERS ( sale_investment ), REMOVEFILTERS ( districts ) )

Отклонение от города, п.п. = [Чистая доходность] - [Чистая доходность по городу]


// ---------- Страница 4. Шорт-лист ----------

Недооценённых квартир =
CALCULATE ( COUNTROWS ( sale_investment ), sale_investment[is_undervalued] = TRUE () )

Медианный дисконт к справедливой цене =
CALCULATE ( MEDIAN ( sale_investment[discount_to_fair] ), sale_investment[is_undervalued] = TRUE () )


// ---------- Страница 3. Инфляция и депозит (таблица roi_scenarios) ----------

ROI за 5 лет = AVERAGE ( roi_scenarios[roi_nominal] )

Реальный ROI за 5 лет = AVERAGE ( roi_scenarios[roi_real] )

Депозит за 5 лет = MAX ( roi_scenarios[deposit_nominal] )

Депозит за 5 лет (реально) = MAX ( roi_scenarios[deposit_real] )


// ---------- Цвета ----------

// Цвет столбца по берегу — для условного форматирования графиков по районам
Цвет берега =
SWITCH (
    SELECTEDVALUE ( districts[bank] ),
    "Левый берег", "#4C72B0",
    "Правый берег", "#DD8452",
    "#8C8C8C"
)
