// =====================================================================
// DAX-меры для отчёта «Выдачи команды продаж»
// Создайте пустую таблицу «_Меры» (Ввод данных → OK) и добавьте меры в неё.
// Таблица dim_date должна быть помечена как таблица дат (Пометить как таблицу дат → date).
// =====================================================================

// ---------- Базовые ----------
Объём, ₸ = SUM ( fact_loans[amount_kzt] )

Объём, млн ₸ = DIVIDE ( [Объём, ₸], 1e6 )

Объём, млрд ₸ = DIVIDE ( [Объём, ₸], 1e9 )

Выдач = COUNTROWS ( fact_loans )

Средний чек, млн ₸ = DIVIDE ( [Объём, ₸], [Выдач] ) / 1e6

Медианный чек, млн ₸ = MEDIAN ( fact_loans[amount_kzt] ) / 1e6

Медианный залоговый чек, млн ₸ =
CALCULATE ( [Медианный чек, млн ₸], fact_loans[product] = "Залоговый займ" )

Доля залоговых в объёме =
DIVIDE ( CALCULATE ( [Объём, ₸], fact_loans[product] = "Залоговый займ" ), [Объём, ₸] )

// ---------- Команда ----------
Активных менеджеров = DISTINCTCOUNT ( fact_loans[manager_id] )

Менеджеро-месяцы =
SUMX ( VALUES ( dim_date[year_month] ), CALCULATE ( DISTINCTCOUNT ( fact_loans[manager_id] ) ) )

Выдач на менеджера в месяц = DIVIDE ( [Выдач], [Менеджеро-месяцы] )

// Утверждённый штат: 6 менеджеров, с мая 2026 года — 7
Штатные менеджеро-месяцы =
SUMX (
    FILTER ( VALUES ( dim_date[month_start] ), dim_date[month_start] <= MAX ( fact_loans[date] ) ),
    IF ( dim_date[month_start] >= DATE ( 2026, 5, 1 ), 7, 6 )
)

Укомплектованность штата = DIVIDE ( [Менеджеро-месяцы], [Штатные менеджеро-месяцы] )

Объём на менеджера в месяц, млн ₸ = DIVIDE ( [Объём, млн ₸], [Менеджеро-месяцы] )

Доля в объёме команды =
DIVIDE ( [Объём, ₸], CALCULATE ( [Объём, ₸], ALL ( dim_manager ) ) )

// ---------- Год к году (сравнивайте сопоставимый период: январь–сентябрь) ----------
Объём LY, ₸ = CALCULATE ( [Объём, ₸], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Δ объёма к прошлому году, % = DIVIDE ( [Объём, ₸] - [Объём LY, ₸], [Объём LY, ₸] )

Выдач LY = CALCULATE ( [Выдач], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Δ выдач к прошлому году, шт = [Выдач] - [Выдач LY]

Δ выдач к прошлому году, % = DIVIDE ( [Выдач] - [Выдач LY], [Выдач LY] )

Выдач на менеджера LY =
CALCULATE ( [Выдач на менеджера в месяц], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Δ продуктивности, % =
DIVIDE ( [Выдач на менеджера в месяц] - [Выдач на менеджера LY], [Выдач на менеджера LY] )

// ---------- Клиенты ----------
Повторных выдач = CALCULATE ( [Выдач], fact_loans[is_repeat] = 1 )

Доля повторных выдач = DIVIDE ( [Повторных выдач], [Выдач] )

Клиентов = DISTINCTCOUNT ( fact_loans[client_id] )

// ---------- Прогноз 4 кв. 2026 ----------
// Факт без неполного октября 2026 (данные по 12.10), чтобы линия не «проваливалась»
Факт для прогноза, млн ₸ =
IF ( MAX ( dim_date[date] ) <= DATE ( 2026, 9, 30 ), [Объём, млн ₸] )

Прогноз: база, млн ₸ = SUM ( fact_forecast[base_mln] )

Прогноз: нижняя граница, млн ₸ = SUM ( fact_forecast[low_mln] )

Прогноз: верхняя граница, млн ₸ = SUM ( fact_forecast[high_mln] )

Прогноз: + беззалог, млн ₸ = SUM ( fact_forecast[s1_unsecured_mln] )

Прогноз: + залоговые, млн ₸ = SUM ( fact_forecast[s2_secured_mln] )

Прогноз: все шаги, млн ₸ = SUM ( fact_forecast[s3_repeat_clients_mln] )

Прогноз 4 кв.: база, млрд ₸ = CALCULATE ( [Прогноз: база, млн ₸], ALL ( dim_date ) ) / 1000

Прогноз 4 кв.: все шаги, млрд ₸ = CALCULATE ( [Прогноз: все шаги, млн ₸], ALL ( dim_date ) ) / 1000

Факт 4 кв. 2025, млрд ₸ =
CALCULATE ( [Объём, млрд ₸], DATESBETWEEN ( dim_date[date], DATE ( 2025, 10, 1 ), DATE ( 2025, 12, 31 ) ) )

Прогноз 4 кв. к 2025, % = DIVIDE ( [Прогноз 4 кв.: база, млрд ₸], [Факт 4 кв. 2025, млрд ₸] ) - 1
